{{!
    @template theme_remui/adv_move_buttons

    Template for rendering block move buttons (move up and move down).

    Example context (json):
    {
        "blockid": "123",
        "movebuttons": [
            {
                "wrapperclass": "move-top",
                "title": "Move up",
                "iconclass": "edw-icon edw-icon-Up"
            },
            {
                "wrapperclass": "move-bottom",
                "title": "Move down",
                "iconclass": "edw-icon edw-icon-Down"
            }
        ]
    }
}}
{{#movebuttons}}
<div class="{{wrapperclass}}" id="yui_3_17_2_1_1687317559796_554">
    <span title="{{title}}">
        <i class="{{iconclass}} d-flex" aria-hidden="true" style="cursor: pointer;"></i>
    </span>
</div>
{{/movebuttons}}


{{#js}}
require(['jquery'], function($){
	$(document).ready(function(){
        if(!$('body[class*="latest-frontpage"]').length > 0 ){
            $({{blockid}}).find(".move-bottom").detach().prependTo("#{{blockid}} .block-header-wrapper .menubar");
            $({{blockid}}).find(".move-top").detach().prependTo("#{{blockid}} .block-header-wrapper .menubar");
        }
	});
});
{{/js}}
